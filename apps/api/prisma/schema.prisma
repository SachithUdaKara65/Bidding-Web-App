generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole             @default(BIDDER)
  status        UserStatus           @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  auditLogs     AuditLog[]
  bids          Bid[]
  evaluations   BidEvaluation[]
  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Organization {
  id                 String               @id @default(uuid())
  name               String
  registrationNumber String               @unique
  type               OrganizationType
  description        String
  address            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  bids               Bid[]
  members            OrganizationMember[]
  tenders            Tender[]

  @@index([name])
}



model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  roleInOrg      String       @default("MEMBER")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Tender {
  id                 String           @id @default(uuid())
  title              String
  description        String
  category           String
  estimatedBudget    Decimal?         @db.Decimal(12, 2)
  status             TenderStatus     @default(DRAFT)
  submissionDeadline DateTime
  openingDate        DateTime
  buyerOrgId         String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  bids               Bid[]
  buyerOrg           Organization     @relation(fields: [buyerOrgId], references: [id])
  award              TenderAward?
  documents          TenderDocument[]

  @@index([status])
  @@index([buyerOrgId])
  @@index([category])
  @@index([submissionDeadline])
}

model TenderDocument {
  id         String   @id @default(uuid())
  tenderId   String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

model Bid {
  id                      String          @id @default(uuid())
  tenderId                String
  bidderOrgId             String
  bidderUserId            String
  technicalProposal       String
  financialProposalAmount Decimal         @db.Decimal(12, 2)
  isSealed                Boolean         @default(true)
  status                  BidStatus       @default(SUBMITTED)
  submittedAt             DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  bidderOrg               Organization    @relation(fields: [bidderOrgId], references: [id])
  bidderUser              User            @relation(fields: [bidderUserId], references: [id])
  tender                  Tender          @relation(fields: [tenderId], references: [id])
  documents               BidDocument[]
  evaluations             BidEvaluation[]
  awardedTender           TenderAward?

  @@unique([tenderId, bidderOrgId])
  @@index([tenderId])
  @@index([bidderOrgId])
  @@index([status])
}

model BidDocument {
  id           String   @id @default(uuid())
  bidId        String
  fileName     String
  fileUrl      String
  documentType String
  uploadedAt   DateTime @default(now())
  bid          Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId])
}

model BidEvaluation {
  id             String   @id @default(uuid())
  bidId          String
  evaluatorId    String
  technicalScore Float
  financialScore Float
  totalScore     Float
  comments       String?
  evaluatedAt    DateTime @default(now())
  bid            Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  evaluator      User     @relation(fields: [evaluatorId], references: [id])

  @@unique([bidId, evaluatorId])
  @@index([bidId])
}

model TenderAward {
  id           String   @id @default(uuid())
  tenderId     String   @unique
  winningBidId String   @unique
  awardNotes   String?
  awardedAt    DateTime @default(now())
  tender       Tender   @relation(fields: [tenderId], references: [id])
  winningBid   Bid      @relation(fields: [winningBidId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
}

enum UserRole {
  BUYER
  BIDDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationType {
  BUYER
  VENDOR
}

enum TenderStatus {
  DRAFT
  PUBLISHED
  OPEN_FOR_BIDDING
  CLOSED
  UNDER_EVALUATION
  AWARDED
  COMPLETED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}
